---
import Base from "@layouts/Base.astro"
import Article from "@components/Article.astro";
import Index from "@layouts/Index.astro";
import Root from "@layouts/Root.astro";

const { page, ...props } = Astro.props;

const { title } = page.frontmatter;
const kind = page.frontmatter?.type || page.frontmatter?.kind || "post";
const wide = Boolean(
  page.frontmatter?.wide || page.frontmatter?.layout === "wide",
);
// measure | folio | folio-wide (parallel texts, dual columns, etc.)
// marginalia shares the folio shell (right gutter for Note / Margin anchors)
const usesFolioShell = kind === "folio" || kind === "marginalia";
const layout = usesFolioShell ? (wide ? "folio-wide" : "folio") : "measure";
---
<Base pageTitle={title} layout={layout}>
  { () => {
    switch (kind) {
      case "root":
        return <Root page={page}><slot /></Root >
      case "index":
        return <Index page={page}><slot /></Index>
      case "post":
      case "article":
      case "folio":
      case "about":
      case "page":
      case "marginalia":
        return <Article frontmatter={page.frontmatter}>
          <slot />
        </Article>
      default:
        return <Article frontmatter={page.frontmatter}>
          <slot />
        </Article>
    }
  }}
</Base>
