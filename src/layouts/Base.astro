---
import 'normalize.css';
import '@style/base.css';
import '@style/prism.css';
import '@components/folio/AlliterativeVerse.css';
import Background from "../components/Background.astro";
import BaseHead from "../components/Head.astro";
import BaseHeader from "../components/Header.astro";
import BaseFooter from "../components/Footer.astro";
import ArticleBorder from "@components/ArticleBorder.astro";

import {SITE_TITLE} from '../consts';

const { pageTitle, layout = 'measure', ...props } = Astro.props;
const title = pageTitle ? `${pageTitle} - ${SITE_TITLE}` : SITE_TITLE
---

<!doctype html>
<html lang="en">
  <BaseHead title={title} />
  <body data-layout={layout}>
    <BaseHeader class="main-header" />
    <main>
      <div id="borderArtWrapper" data-turbo-permanent>
        <ArticleBorder class="borderArt" />
      </div>
      <slot />
    </main>
    <BaseFooter class="main-footer" />
    <script type="module">
      import hotwiredTurbo from "https://cdn.skypack.dev/@hotwired/turbo";
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    background-color: var(--bg);
    color: var(--fg);
    background-image: url(/images/background.png);
    background-repeat: repeat;
    font-size: 2rem;
    font-weight: 400;
    min-height: 100vh;
    margin: unset;

    /*
     * Site rails (shared by header / main / footer).
     * html font-size 62.5% → 1rem ≈ 10px
     *
     *   left-rail       borderArt pocket
     *   article-inset   shift of text column within main
     *   left-notes      scribal gloss column (Scribe / Sidenote)
     *   sidenote-left-min-top
     *                   fallback floor (Scribe Y) below border art; layout
     *                   also measures #articleBorder .man when present
     *   sidenote-left-snap
     *                   only if the anchor is *just* above that floor
     *                   (within this distance) stay left and push down;
     *                   anything higher flips to the right gutter
     *   measure         reading column (prose / Poem)
     *   gutter + margin right: flowing Note + fixed Margin figures
     */
    --folio-left-rail: 26rem;
    --folio-article-inset: 9rem;
    --folio-left-notes: 20rem;
    --folio-sidenote-left-min-top: 18rem;
    --folio-sidenote-left-snap: 2.5rem;
    --folio-measure: 66.9rem;
    --folio-measure-wide: 104rem; /* rare dual-column specimens */
    --folio-gutter: 2.5rem;
    --folio-margin: 24rem;
    --folio-footer-inset: 4rem;
  }

  /*
   * folio-wide: broaden the reading measure for parallel text without
   * changing home/about/default folio.
   */
  body[data-layout='folio-wide'] {
    --folio-measure: var(--folio-measure-wide);
  }

  main {
    position: relative;
    margin: 0 auto;
    max-width: var(--folio-measure);
    padding: 0 1rem;
    width: 100%;
    flex: 1 0 auto;
    line-height: 2.5rem;
    overflow: visible;
  }

  /* Content column only — not <main> chrome */
  :global(article.index) {
    margin-top: 3rem;
  }

  @media (min-width: 960px) {
    /*
     * measure  → inset + measure (home, about, indexes)
     * folio    → + note gutter (single-column primary text + sidenotes)
     * folio-wide → same shell math, but --folio-measure is widened above
     */
    main {
      margin-left: var(--folio-left-rail);
      margin-right: auto;
      max-width: calc(var(--folio-article-inset) + var(--folio-measure));
      width: 100%;
      padding-left: 0;
      padding-right: 1rem;
      overflow: visible;
    }

    body[data-layout='folio'] main,
    body[data-layout='folio-wide'] main {
      /* room for Scribe: left notes (via breakout) + measure + right margin */
      max-width: calc(
        var(--folio-left-notes) + var(--folio-gutter) + var(--folio-measure) +
          var(--folio-gutter) + var(--folio-margin)
      );
    }

    /*
     * Article = reading column only (floats stay here).
     * FolioRow breaks out into the note gutter on folio / folio-wide.
     */
    main :global(article),
    main :global(section.rolladex) {
      box-sizing: border-box;
      display: flow-root;
      /* Positioning context for text-anchored right <Margin> panels */
      position: relative;
      width: var(--folio-measure);
      max-width: var(--folio-measure);
      margin-left: var(--folio-article-inset);
      margin-right: 0;
      overflow: visible;
    }

    main :global(article.index) {
      margin-top: 3rem;
    }

    main :global(article .headingWrapper),
    main :global(article section) {
      max-width: 100%;
      overflow: visible;
    }
  }

  @media (max-width: 760px) {
    .borderArt {
      display: none;
    }
  }
</style>
