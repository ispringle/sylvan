---
import HeaderArt from "./HeaderArt.astro";
import Navigation from "./Navigation.astro";
const { class: className } = Astro.props;
---

<style>
  header {
    padding: 2rem 0 10rem;
    margin: 0 auto;
    max-width: var(--folio-measure, 66.9rem);
    width: 100%;
    box-sizing: border-box;
  }

  /*
   * Align with the reading column (left rail + article inset).
   * align-self: flex-start is required: body is a column flex container and
   * would otherwise stretch the header full-bleed, ignoring the left shift.
   */
  @media (min-width: 960px) {
    header {
      align-self: flex-start;
      width: auto;
      max-width: var(--folio-measure, 66.9rem);
      margin-left: calc(
        var(--folio-left-rail, 26rem) + var(--folio-article-inset, 9rem)
      );
      margin-right: auto;
      padding-left: 0;
      padding-right: 1rem;
    }
  }

  @media (max-width: 760px) {
    header {
      display: flex;
      flex-direction: column;
      align-items: center;
      align-self: center;
      padding: 1rem 0 10rem;
      margin: 0 auto;
      width: 100%;
    }
  }
  @media (max-width: 450px) {
    header {
      padding: 0 0 5rem;
    }
  }
</style>
<header class={className}>
  <HeaderArt />
  <Navigation />
</header>
