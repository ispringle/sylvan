---
import Date from "./Date.astro"
const { card: {frontmatter} } = Astro.props
const href = frontmatter.link
---
<style>
*, *:hover {
  cursor: var(--cursor-default-left),
  var(--cursor-default-right),
  var(--cursor-alt-left-up),
  var(--cursor-alt-right-up),
  var(--cursor-alt-left-down),
  var(--cursor-alt-right-down),
  auto !important;
}
.card {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
}
span {
    flex: 1;
}
</style>
<script is:inline>
</script>
<div onmouseenter="new Audio('/audio/effects/pa-choop.m4a').play();" class="card">

    {frontmatter.type !== 'folio' && frontmatter.type !== 'marginalia' && <Date date={frontmatter.created} />}
    <span>
    <a href={href} >
        {frontmatter.title || frontmatter.slug}
    </a>
    </span>
</div>
