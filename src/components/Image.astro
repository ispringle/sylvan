---
import { Image as AstroImage } from 'astro:assets';

const {
  alt = '',
  src,
  width,
  height,
  float = 'right',
  margin = '0 0 1rem 1rem',
  class: className,
  ...rest
} = Astro.props;

// Markdown/MDX often passes image metadata objects from resolve-image imports.
const imageSrc = src;
const displayWidth = width ?? 300;
---
<style>
  img.inline-img {
    object-fit: contain;
    max-width: min(100%, 300px);
    height: auto;
  }
</style>
<AstroImage
  class:list={['inline-img', className]}
  alt={alt}
  src={imageSrc}
  widths={[displayWidth, displayWidth * 2]}
  style={{
    float,
    width: typeof displayWidth === 'number' ? `${displayWidth}px` : displayWidth,
    height: height ?? 'auto',
    margin,
  }}
  {...rest}
/>
