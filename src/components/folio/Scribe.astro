---
/**
 * Three-track scribal shell around a poem:
 *
 *   left notes (Sidenote) | measure (Poem) | right (Margin fixed + Note flow)
 *
 * Border-art clearance (from Scribe top):
 *   --folio-sidenote-left-min-top  safe Y below the vines/man
 *   --folio-sidenote-left-snap     if anchor is within this band above
 *                                   min-top, stay left and push down;
 *                                   only flip right when higher still
 *
 * Authoring — put everything in the default slot; layout script sorts:
 *
 *   <Scribe>
 *     <Poem>…</Poem>
 *     <Sidenote at={1} title="…">…</Sidenote>
 *     <!-- multi-target: shared data-anchor id, or at={[2, 5, 'foo']} -->
 *     <Sidenote at="mere-naming" title="…">…</Sidenote>
 *     <Note title="…">flowing commentary</Note>
 *     <Margin>…optional fixed figure…</Margin>
 *   </Scribe>
 */
---

<div class="folio-scribe" data-scribe>
  <div class="folio-scribe__left" data-scribe-left aria-label="Marginal notes"></div>
  <div class="folio-scribe__center" data-scribe-center>
    <slot />
  </div>
  <div class="folio-scribe__right" data-scribe-right aria-label="Commentary and figures"></div>
</div>

<style is:global>
  :root {
    --folio-left-notes: 20rem;
  }

  .folio-scribe {
    position: relative;
    display: block;
    margin: 0 0 2.5rem;
    max-width: 100%;
  }

  @media (min-width: 960px) {
    .folio-scribe {
      /*
       * Full breakout: left notes + measure + right margin.
       * Center column holds the poem; gutters are populated by script.
       */
      display: grid;
      grid-template-columns:
        var(--folio-left-notes)
        var(--folio-measure, 66.9rem)
        var(--folio-margin, 24rem);
      column-gap: var(--folio-gutter, 2.5rem);
      width: calc(
        var(--folio-left-notes) + var(--folio-measure, 66.9rem) +
          var(--folio-margin, 24rem) + 2 * var(--folio-gutter, 2.5rem)
      );
      max-width: none;
      box-sizing: content-box;
      /* Shift left so the *poem* still starts near article measure origin:
         article is measure-wide; we pull left by left-notes + gutter */
      margin-left: calc(
        -1 * (var(--folio-left-notes) + var(--folio-gutter, 2.5rem))
      );
    }

    .folio-scribe__left,
    .folio-scribe__right {
      position: relative;
      min-width: 0;
      min-height: 1px;
    }

    .folio-scribe__center {
      min-width: 0;
      max-width: var(--folio-measure, 66.9rem);
    }

    /* While JS runs, keep authored sidenotes/notes from breaking the poem flow */
    .folio-scribe__center > .sidenote,
    .folio-scribe__center > .folio-note,
    .folio-scribe__center > .margin {
      /* script moves these; hide until placed to avoid flash in center */
    }
  }

  /* Prose anchors inside Excerpt (invisible markers / highlight targets) */
  [data-anchor] {
    border-radius: 0.12rem;
    transition: background 0.12s ease;
  }

  [data-anchor].is-active {
    background: color-mix(in srgb, var(--default-blue, #b4d5fe) 22%, transparent);
    outline: 0.08rem solid color-mix(in srgb, var(--fg) 22%, var(--bg));
  }

  /* Excerpt sits cleanly in the center track */
  .folio-scribe__center > .folio-excerpt {
    margin-top: 0;
    max-width: 100%;
  }

  /* Title / dedication / addressee above a poem inside Scribe */
  .folio-scribe__center > .poem-front {
    margin: 0 0 1.75rem;
    max-width: 100%;
  }

  .folio-scribe__center > .poem-front > :first-child {
    margin-top: 0;
  }

  .folio-scribe__center > .poem-front h1 {
    margin-bottom: 0.35em;
  }

  .folio-scribe__center > .poem-front p {
    margin: 0.55em 0;
  }

  .folio-scribe__center > .poem-front [data-anchor] {
    border-radius: 0.12rem;
    cursor: help;
    transition: background 0.12s ease, outline-color 0.12s ease;
  }

  /*
   * Sidenotes flipped to the right gutter (above left clearance).
   * Accent faces the measure; still reads as a scribal card, not a Note.
   */
  .folio-scribe__right > .sidenote,
  .sidenote.sidenote--flipped-right {
    max-width: 100%;
    border-left-width: 0.22rem;
    border-right-width: 0.1rem;
    box-shadow: -0.12rem 0.12rem 0 color-mix(in srgb, var(--fg) 10%, transparent);
  }

  .folio-scribe__right > .sidenote.is-active,
  .folio-scribe__right > .sidenote.is-pinned,
  .sidenote.sidenote--flipped-right.is-active,
  .sidenote.sidenote--flipped-right.is-pinned {
    box-shadow: -0.18rem 0.18rem 0 color-mix(in srgb, var(--fg) 14%, transparent);
  }

  @media (max-width: 959px) {
    .folio-scribe__left,
    .folio-scribe__right {
      display: block;
      margin-top: 1.25rem;
    }

    .sidenote.sidenote--flipped-right {
      box-shadow: 0.12rem 0.12rem 0 color-mix(in srgb, var(--fg) 10%, transparent);
      border-left-width: 0.22rem;
      border-right-width: 0.1rem;
    }
  }
</style>

<script>
  function rootPx() {
    return parseFloat(getComputedStyle(document.documentElement).fontSize) || 10;
  }

  function cssRem(name, fallback) {
    const raw = getComputedStyle(document.body).getPropertyValue(name);
    const n = parseFloat(raw);
    return (Number.isFinite(n) ? n : fallback) * rootPx();
  }

  function offsetTopIn(el, ancestor) {
    const er = el.getBoundingClientRect();
    const ar = ancestor.getBoundingClientRect();
    return er.top - ar.top + ancestor.scrollTop;
  }

  /**
   * Y (from Scribe top) where the left border figure ends — left notes
   * should start at or below this. Prefer measuring the man; fall back
   * to --folio-sidenote-left-min-top. Small pad so cards clear the art.
   */
  function leftClearanceY(scribe) {
    const fallback = cssRem('--folio-sidenote-left-min-top', 18);
    const pad = 0.75 * rootPx();
    const man = document.querySelector('#articleBorder .man');
    if (!man) return fallback;
    const y =
      man.getBoundingClientRect().bottom -
      scribe.getBoundingClientRect().top +
      pad;
    if (!Number.isFinite(y) || y <= 0) return fallback;
    // Use the larger of measured vs configured so a short man never
    // under-clears when the vines still crowd the pocket.
    return Math.max(y, fallback);
  }

  /** Split data-at into keys (space and/or comma separated). */
  function parseAtList(value) {
    if (value === undefined || value === null || value === '') return [];
    return String(value)
      .split(/[\s,]+/)
      .map((s) => s.trim())
      .filter(Boolean);
  }

  /**
   * Targets for one key: poem line by number, or every [data-anchor="…"]
   * (and optional #id). Multiple spans may share the same data-anchor id.
   */
  function anchorEls(scribe, at) {
    if (at === undefined || at === null || at === '') return [];
    const key = String(at);
    if (/^\d+$/.test(key)) {
      const line = scribe.querySelector(`.poem-line[data-line="${key}"]`);
      return line ? [line] : [];
    }
    const byAnchor = Array.from(
      scribe.querySelectorAll(`[data-anchor="${CSS.escape(key)}"]`),
    );
    if (byAnchor.length) return byAnchor;
    const byId = scribe.querySelector(`#${CSS.escape(key)}`);
    return byId ? [byId] : [];
  }

  /** First target for layout positioning. */
  function anchorEl(scribe, at) {
    const keys = parseAtList(at);
    for (const key of keys.length ? keys : [at]) {
      const found = anchorEls(scribe, key);
      if (found.length) return found[0];
    }
    return null;
  }

  /** Sidenotes whose data-at list includes this key. */
  function sidenotesForKey(scribe, key) {
    const k = String(key);
    return Array.from(scribe.querySelectorAll('[data-sidenote]')).filter((sn) =>
      parseAtList(sn.getAttribute('data-at')).includes(k),
    );
  }

  function layoutScribe(scribe) {
    const wide = window.matchMedia('(min-width: 960px)').matches;
    const leftCol = scribe.querySelector('[data-scribe-left]');
    const center = scribe.querySelector('[data-scribe-center]');
    const rightCol = scribe.querySelector('[data-scribe-right]');
    if (!leftCol || !center || !rightCol) return;

    const sidenotes = Array.from(
      scribe.querySelectorAll('[data-sidenote]'),
    );
    const flowingNotes = Array.from(
      center.querySelectorAll(':scope > .folio-note, :scope > .folio-notes'),
    ).concat(
      Array.from(rightCol.querySelectorAll(':scope > .folio-note, :scope > .folio-notes')),
    );
    // Margins may be in center or already hosted
    const margins = Array.from(scribe.querySelectorAll('[data-margin]'));

    if (!wide) {
      // Stack: poem (center) already first; move notes below into left/right as flow
      sidenotes.forEach((sn) => {
        sn.classList.remove('sidenote--flipped-right');
        sn.style.position = '';
        sn.style.top = '';
        sn.style.left = '';
        sn.style.transform = '';
        sn.style.zIndex = '';
        sn.style.width = '';
        leftCol.appendChild(sn);
      });
      flowingNotes.forEach((n) => {
        n.style.position = '';
        n.style.top = '';
        n.style.left = '';
        n.style.width = '';
        rightCol.appendChild(n);
      });
      // leave margins to their own script / static
      return;
    }

    const stackGap = 0.65 * rootPx();
    // Floor = below border man (measured) / CSS fallback.
    // Snap = only *barely* above that floor → stay left and push down;
    // anything higher (title, dedication, Philomythus…) → right gutter.
    const leftMinTop = leftClearanceY(scribe);
    const leftSnap = cssRem('--folio-sidenote-left-snap', 2.5);
    const flipCeiling = leftMinTop - leftSnap;

    const placed = sidenotes.map((sn) => {
      const at = sn.getAttribute('data-at') || '';
      const target = anchorEl(scribe, at);
      const naturalTop = target ? offsetTopIn(target, scribe) : 0;
      return { sn, target, naturalTop };
    });

    const leftPlaced = placed
      .filter((p) => p.naturalTop >= flipCeiling)
      .sort((a, b) => a.naturalTop - b.naturalTop || 0);
    const rightFlip = placed
      .filter((p) => p.naturalTop < flipCeiling)
      .sort((a, b) => a.naturalTop - b.naturalTop || 0);

    // --- Left: clear of art (or snapped just under it), then sticky stack ---
    let lastBottom = -Infinity;
    let stackIndex = 0;

    leftPlaced.forEach(({ sn, naturalTop }) => {
      sn.classList.remove('sidenote--flipped-right');
      leftCol.appendChild(sn);
      // Near-miss anchors: push down to clearance; already-clear keep Y
      let top = Math.max(naturalTop, leftMinTop);
      if (top < lastBottom + stackGap) {
        top = lastBottom + stackGap;
        stackIndex += 1;
      } else {
        stackIndex = 0;
      }
      sn.style.position = 'absolute';
      sn.style.left = '0';
      sn.style.width = '100%';
      sn.style.top = Math.round(top) + 'px';
      sn.style.right = 'auto';
      const jitter = (stackIndex % 3) * 0.15;
      sn.style.transform =
        stackIndex > 0
          ? `translateX(${jitter}rem) rotate(${stackIndex % 2 ? -0.35 : 0.35}deg)`
          : '';
      sn.style.zIndex = String(10 + stackIndex);
      lastBottom = top + (sn.offsetHeight || 0);
    });

    leftCol.style.minHeight = Math.round(Math.max(lastBottom, 0)) + 'px';

    // --- Right: margins (fixed Y) → flipped high sidenotes → flowing notes ---
    /** @type {{top:number, bottom:number}[]} */
    const reserved = [];

    function fits(start, height) {
      const end = start + height;
      for (const r of reserved) {
        if (start < r.bottom && end > r.top) return false;
      }
      return true;
    }

    function nextFree(start, height) {
      let y = Math.max(0, start);
      for (let guard = 0; guard < 200; guard++) {
        if (fits(y, height)) return y;
        let bumped = false;
        for (const r of reserved) {
          if (y < r.bottom && y + height > r.top) {
            y = r.bottom + stackGap;
            bumped = true;
            break;
          }
        }
        if (!bumped) y += stackGap;
      }
      return y;
    }

    margins.forEach((m) => {
      const at = m.getAttribute('data-at') || '';
      rightCol.appendChild(m);
      let top = 0;
      if (at) {
        const target = anchorEl(scribe, at);
        top = target ? offsetTopIn(target, scribe) : 0;
      }
      m.style.position = 'absolute';
      m.style.left = '0';
      m.style.width = '100%';
      m.style.top = Math.round(top) + 'px';
      const inner = m.querySelector('.margin__panel');
      if (inner) {
        inner.hidden = false;
        inner.style.position = 'static';
        inner.style.left = '';
        inner.style.top = '';
        inner.style.width = '100%';
      }
      const h = m.offsetHeight || 0;
      reserved.push({ top, bottom: top + h });
    });

    reserved.sort((a, b) => a.top - b.top);

    // High anchors: same vertical band as the text, but in the right track
    rightFlip.forEach(({ sn, naturalTop }) => {
      sn.classList.add('sidenote--flipped-right');
      rightCol.appendChild(sn);
      sn.style.position = 'absolute';
      sn.style.left = '0';
      sn.style.width = '100%';
      sn.style.boxSizing = 'border-box';
      sn.style.right = 'auto';
      sn.style.transform = '';
      sn.style.zIndex = '12';
      sn.style.top = '0';
      sn.style.visibility = 'hidden';
      const h = sn.offsetHeight || 120;
      sn.style.visibility = '';
      const y = nextFree(naturalTop, h);
      sn.style.top = Math.round(y) + 'px';
      reserved.push({ top: y, bottom: y + h });
      reserved.sort((a, b) => a.top - b.top);
    });

    let flowY = 0;
    flowingNotes.forEach((note) => {
      rightCol.appendChild(note);
      note.style.position = 'absolute';
      note.style.left = '0';
      note.style.width = '100%';
      note.style.boxSizing = 'border-box';
      note.style.top = '0';
      note.style.visibility = 'hidden';
      const h = note.offsetHeight || 120;
      note.style.visibility = '';
      const y = nextFree(flowY, h);
      note.style.top = Math.round(y) + 'px';
      reserved.push({ top: y, bottom: y + h });
      reserved.sort((a, b) => a.top - b.top);
      flowY = y + h + stackGap;
    });

    const rightBottom = reserved.reduce((m, r) => Math.max(m, r.bottom), 0);
    rightCol.style.minHeight = Math.round(rightBottom) + 'px';
  }

  function bindHighlights(scribe) {
    if (scribe.dataset.highlightBound) return;
    scribe.dataset.highlightBound = '1';

    function clearPin() {
      scribe
        .querySelectorAll(
          '.sidenote.is-pinned, .poem-line.is-pinned, [data-anchor].is-pinned',
        )
        .forEach((el) => {
          el.classList.remove('is-pinned');
        });
      clearActive();
    }

    function clearActive() {
      scribe
        .querySelectorAll(
          '.sidenote.is-active, .poem-line.is-active, [data-anchor].is-active',
        )
        .forEach((el) => el.classList.remove('is-active'));
    }

    /**
     * Activate a note (or every note linked to `key`) and all of its targets.
     * Shared data-anchor ids light up every matching span; multi-key data-at
     * lights the full set.
     */
    function activate(keyOrNote, pin) {
      if (!pin) clearActive();

      /** @type {Element[]} */
      let notes = [];
      if (keyOrNote instanceof Element) {
        notes = [keyOrNote];
      } else if (keyOrNote != null && keyOrNote !== '') {
        notes = sidenotesForKey(scribe, keyOrNote);
        // Fallback: exact data-at match (legacy single-value selectors)
        if (!notes.length) {
          const exact = scribe.querySelector(
            `[data-sidenote][data-at="${CSS.escape(String(keyOrNote))}"]`,
          );
          if (exact) notes = [exact];
        }
      }

      for (const sn of notes) {
        sn.classList.add('is-active');
        if (pin) sn.classList.add('is-pinned');
        for (const key of parseAtList(sn.getAttribute('data-at'))) {
          for (const target of anchorEls(scribe, key)) {
            target.classList.add('is-active');
            if (pin) target.classList.add('is-pinned');
          }
        }
      }
    }

    function keyFromTextTarget(el) {
      if (!el) return null;
      // Prefer explicit phrase anchors over the whole poem line
      const anc = el.closest?.('[data-anchor]');
      if (anc) return anc.getAttribute('data-anchor');
      const line = el.closest?.('.poem-line');
      if (line?.hasAttribute('data-line')) return line.getAttribute('data-line');
      return null;
    }

    function hasLinkedNote(key) {
      return key && sidenotesForKey(scribe, key).length > 0;
    }

    scribe.addEventListener('mouseover', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const sn = t.closest('[data-sidenote]');
      if (sn && scribe.contains(sn)) {
        if (!scribe.querySelector('.sidenote.is-pinned')) {
          activate(sn, false);
        }
        return;
      }
      const key = keyFromTextTarget(t);
      if (hasLinkedNote(key) && !scribe.querySelector('.sidenote.is-pinned')) {
        activate(key, false);
      }
    });

    scribe.addEventListener('mouseout', (e) => {
      if (scribe.querySelector('.sidenote.is-pinned')) return;
      const rel = e.relatedTarget;
      if (rel instanceof Node && scribe.contains(rel)) {
        const overSn = rel.closest?.('[data-sidenote]');
        const overKey = keyFromTextTarget(rel);
        if (overSn || hasLinkedNote(overKey)) {
          return;
        }
      }
      clearActive();
    });

    scribe.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const sn = t.closest('[data-sidenote]');
      if (sn && scribe.contains(sn)) {
        e.stopPropagation();
        if (sn.classList.contains('is-pinned')) {
          clearPin();
        } else {
          clearPin();
          activate(sn, true);
        }
        return;
      }
      const key = keyFromTextTarget(t);
      if (hasLinkedNote(key)) {
        e.stopPropagation();
        const pinned = sidenotesForKey(scribe, key).some((n) =>
          n.classList.contains('is-pinned'),
        );
        if (pinned) {
          clearPin();
        } else {
          clearPin();
          activate(key, true);
        }
      }
    });

    document.addEventListener('click', (e) => {
      if (!scribe.querySelector('.sidenote.is-pinned')) return;
      const t = e.target;
      if (t instanceof Node && scribe.contains(t)) return;
      clearPin();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') clearPin();
    });
  }

  function initOne(scribe) {
    layoutScribe(scribe);
    bindHighlights(scribe);
    scribe.querySelectorAll('img').forEach((img) => {
      if (!img.complete) {
        img.addEventListener(
          'load',
          () => layoutScribe(scribe),
          { once: true },
        );
      }
    });
  }

  function init() {
    document.querySelectorAll('[data-scribe]').forEach(initOne);
  }

  init();
  document.addEventListener('astro:page-load', init);
  window.addEventListener('resize', () => {
    document.querySelectorAll('[data-scribe]').forEach(layoutScribe);
  });
</script>
