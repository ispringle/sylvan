---
/**
 * Right-gutter anchor — fixed to a place in the text, always visible.
 *
 * Use for illustrations (and the rare prose note) that should sit beside a
 * specific line. Free-floating section commentary still uses <Note> in a
 * FolioRow. Left-gutter hover footnotes use <Fn>.
 *
 *   they beheld the elves
 *   <Margin>
 *     <Illustration src={…} credit="…" float="none" />
 *   </Margin>
 *
 * Optional title / in-text mark:
 *   <Margin title="Elves" mark>…</Margin>
 *   <Margin mark="†">…</Margin>
 *
 * Panels are position:absolute against the article so they scroll with the page.
 * Illustration captions are hidden until the figure is hovered (see Illustration).
 */
interface Props {
  title?: string;
  id?: string;
  /**
   * Poem line number or prose data-anchor id — used by <Scribe> to pin this
   * figure in the right gutter beside that place in the text.
   */
  at?: number | string;
  /** Show a small mark at the anchor (true → ❧, or a custom string) */
  mark?: boolean | string;
}

const { title, id, at, mark = false } = Astro.props;
const markText =
  mark === true ? '❧' : typeof mark === 'string' && mark.length ? mark : '';
const atAttr = at === undefined || at === null ? undefined : String(at);
---

<span class="margin" data-margin data-at={atAttr} id={id}>
  {
    markText ? (
      <span class="margin__mark" aria-hidden="true">
        {markText}
      </span>
    ) : (
      <span class="margin__anchor" aria-hidden="true"></span>
    )
  }
  <aside class="margin__panel" role="complementary">
    <div class="margin__body">
      <slot />
    </div>
    {
      title ? (
        <div class="margin__slip">
          <p class="margin__title">
            <span class="margin__title-text">{title}</span>
          </p>
        </div>
      ) : (
        <div class="margin__slip" data-slip-host hidden></div>
      )
    }
  </aside>
</span>

<style is:global>
  .margin {
    display: inline;
    position: static;
  }

  .margin__anchor {
    display: inline-block;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .margin__mark {
    display: inline;
    margin: 0 0.1em;
    color: color-mix(in srgb, var(--fg) 45%, var(--bg));
    font-size: 0.85em;
    user-select: none;
  }

  .margin__panel {
    position: relative;
    box-sizing: border-box;
    z-index: 15;
    width: var(--folio-margin, 24rem);
    max-width: min(var(--folio-margin, 24rem), calc(100vw - 2rem));
    padding: 0;
    border: none;
    background: transparent;
    color: color-mix(in srgb, var(--fg) 90%, var(--bg));
    font-size: 1.35rem;
    line-height: 1.4;
    pointer-events: auto;
    overflow: visible;
  }

  .margin__body {
    display: block;
    position: relative;
  }

  .margin__body > :first-child {
    margin-top: 0;
  }

  .margin__body > :last-child {
    margin-bottom: 0;
  }

  .margin__body p {
    margin: 0 0 0.65em;
  }

  .margin__body p:last-child {
    margin-bottom: 0;
  }

  /*
   * One parchment slip under the image: title then caption (caption is
   * moved into the slip by script). Absolute → image never shifts.
   */
  .margin__slip {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 5;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.3rem 0 0;
    padding: 0.4rem 0.55rem 0.45rem;
    color: var(--fg);
    background: var(--bg, #fffff8);
    border: 0.08rem solid color-mix(in srgb, var(--fg) 32%, var(--bg));
    box-shadow: 0.1rem 0.1rem 0 color-mix(in srgb, var(--fg) 10%, transparent);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  /* No title and no caption → never show the empty parchment box */
  .margin__slip:not(:has(*)),
  .margin__slip[hidden] {
    display: none;
  }

  .margin__panel:hover .margin__slip:has(*),
  .margin__panel:focus-within .margin__slip:has(*) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .margin__title {
    margin: 0;
    padding: 0;
    font-family: 'Metamorphous', serif;
    font-size: 0.72em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    background: transparent;
    border: none;
    box-shadow: none;
    opacity: 1;
    visibility: visible;
  }

  .margin__title-text {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Caption inside the slip: normal flow, no second absolute hang */
  .margin__slip .folio-illustration__caption {
    position: static;
    left: auto;
    right: auto;
    top: auto;
    margin: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: transparent;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    font-size: 0.72em;
    color: color-mix(in srgb, var(--fg) 78%, var(--bg));
  }

  .margin__panel .folio-illustration,
  .margin__panel .folio-illustration--right,
  .margin__panel .folio-illustration--left {
    float: none;
    clear: none;
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  @media (max-width: 959px) {
    .margin {
      display: block;
      margin: 0.85rem 0 1.1rem;
    }

    .margin__panel {
      width: 100%;
      max-width: min(28rem, 100%);
    }

    .margin__panel .margin__slip:has(*) {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }
</style>

<script>
  function rootPx() {
    return parseFloat(getComputedStyle(document.documentElement).fontSize) || 10;
  }

  function cssRem(name, fallback) {
    const raw = getComputedStyle(document.body).getPropertyValue(name);
    const n = parseFloat(raw);
    return (Number.isFinite(n) ? n : fallback) * rootPx();
  }

  function offsetIn(el, ancestor) {
    const er = el.getBoundingClientRect();
    const ar = ancestor.getBoundingClientRect();
    return {
      top: er.top - ar.top + ancestor.scrollTop,
      left: er.left - ar.left + ancestor.scrollLeft,
    };
  }

  function uidFor(marginEl) {
    if (!marginEl.dataset.marginUid) {
      marginEl.dataset.marginUid =
        marginEl.id || 'm-' + Math.random().toString(36).slice(2, 9);
    }
    return marginEl.dataset.marginUid;
  }

  function findPanel(marginEl, article) {
    const uid = marginEl.dataset.marginUid;
    return (
      marginEl.querySelector('.margin__panel') ||
      (uid &&
        article &&
        article.querySelector(
          `.margin__panel[data-margin-for="${CSS.escape(uid)}"]`,
        )) ||
      null
    );
  }

  function hostPanel(panel, article, marginEl) {
    const uid = uidFor(marginEl);
    panel.dataset.marginFor = uid;
    if (panel.parentElement !== article) {
      article.appendChild(panel);
    }
  }

  function placeAllMargins() {
    const wide = window.matchMedia('(min-width: 960px)').matches;
    // Scribe-owned margins are laid out by Scribe.astro
    const items = Array.from(document.querySelectorAll('[data-margin]')).filter(
      (el) => !el.closest('[data-scribe]'),
    );
    if (!items.length) return;

    if (!wide) {
      items.forEach((el) => {
        const article = el.closest('article');
        const panel = findPanel(el, article);
        if (panel && panel.parentElement !== el) {
          el.appendChild(panel);
        }
        if (!panel) return;
        panel.style.position = '';
        panel.style.top = '';
        panel.style.left = '';
        panel.style.width = '';
      });
      return;
    }

    const gap = cssRem('--folio-gutter', 2.5);
    const marginW = cssRem('--folio-margin', 24);
    const stackGap = 0.85 * rootPx();

    const byArticle = new Map();
    items.forEach((el) => {
      const article = el.closest('article');
      if (!article) return;
      uidFor(el);
      if (!byArticle.has(article)) byArticle.set(article, []);
      byArticle.get(article).push(el);
    });

    byArticle.forEach((list, article) => {
      let lastBottom = -Infinity;
      const colW = article.clientWidth;

      list.forEach((el) => {
        const panel = findPanel(el, article);
        const anchor =
          el.querySelector('.margin__mark') ||
          el.querySelector('.margin__anchor') ||
          el;
        if (!panel) return;

        hostPanel(panel, article, el);

        const { top: anchorTop } = offsetIn(anchor, article);
        let top = anchorTop;
        if (top < lastBottom + stackGap) {
          top = lastBottom + stackGap;
        }

        panel.style.position = 'absolute';
        panel.style.width = Math.round(marginW) + 'px';
        panel.style.left = Math.round(colW + gap) + 'px';
        panel.style.top = Math.round(top) + 'px';
        panel.style.right = 'auto';

        const panelH =
          panel.offsetHeight || panel.getBoundingClientRect().height;
        lastBottom = top + panelH;
      });
    });
  }

  let scheduled = false;
  function schedulePlace() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => {
      scheduled = false;
      placeAllMargins();
    });
  }

  /** Move figure captions into the hang slip under the image (with title). */
  function collectSlips() {
    document.querySelectorAll('.margin__panel').forEach((panel) => {
      const slip = panel.querySelector('.margin__slip');
      if (!slip) return;
      panel.querySelectorAll('.folio-illustration__caption').forEach((cap) => {
        if (cap.parentElement !== slip) {
          slip.appendChild(cap);
        }
      });
      // Reveal host only when it actually has content (title or caption)
      if (slip.hasAttribute('hidden') || slip.hasAttribute('data-slip-host')) {
        if (slip.children.length) {
          slip.removeAttribute('hidden');
        } else {
          slip.setAttribute('hidden', '');
        }
      }
    });
  }

  function init() {
    collectSlips();
    // Inside <Scribe>, the shell owns right-gutter placement via data-at.
    const free = Array.from(
      document.querySelectorAll('[data-margin]'),
    ).filter((el) => !el.closest('[data-scribe]'));
    if (!free.length) return;
    placeAllMargins();
    free.forEach((el) => {
      el.querySelectorAll('img').forEach((img) => {
        if (!img.complete) {
          img.addEventListener('load', schedulePlace, { once: true });
        }
      });
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
  window.addEventListener('resize', () => {
    if (
      document.querySelector(
        '[data-margin]:not([data-scribe] [data-margin])',
      )
    ) {
      schedulePlace();
    }
  });
</script>
