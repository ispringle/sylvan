---
/**
 * Figure with required credit / license for Folio images.
 *
 *   <Illustration
 *     src={ruthwell}
 *     alt="The Ruthwell Cross"
 *     credit="Photograph of the Ruthwell Cross"
 *     license="public-domain"
 *     source="Wikimedia Commons"
 *     framed
 *   />
 *
 * `framed` is opt-in: square manuscript crops look better with a border;
 * irregular / transparent art (custom drolleries) should omit it.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  /** Omit credit/source to hide the caption slip entirely */
  credit?: string;
  license?: string;
  source?: string;
  id?: string;
  /** Prefer float right like other content images */
  float?: 'left' | 'right' | 'none';
  /** Thin border around the image (good for square crops; off by default) */
  framed?: boolean;
}

const {
  src,
  alt,
  credit,
  // Omit to hide license line (still credit source when given)
  license,
  source,
  id,
  float = 'none',
  framed = false,
} = Astro.props;

const isRemote = typeof src === 'string';
const hasCaption = Boolean(credit || license || source);
---

<figure
  class:list={[
    'folio-illustration',
    float !== 'none' && `folio-illustration--${float}`,
    framed && 'folio-illustration--framed',
  ]}
  id={id}
>
  {
    isRemote ? (
      <img class="folio-illustration__img" src={src as string} alt={alt} loading="lazy" />
    ) : (
      <Image class="folio-illustration__img" src={src as ImageMetadata} alt={alt} widths={[400, 800]} />
    )
  }
  {
    hasCaption && (
      <figcaption class="folio-illustration__caption">
        {credit && <span class="folio-illustration__credit">{credit}</span>}
        {(license || source) && (
          <span class="folio-illustration__meta">
            {license && <span class="folio-illustration__license">{license}</span>}
            {license && source && ' · '}
            {source && <span class="folio-illustration__source">{source}</span>}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style is:global>
  /*
   * Contain a floated illustration with surrounding prose so it cannot
   * spill into the poem / FolioRow below.
   */
  .folio-lede {
    display: flow-root;
    margin: 0 0 1.75rem;
  }

  .folio-illustration {
    position: relative;
    margin: 1.5rem 0 2rem;
    padding: 0;
    border: none;
    max-width: min(100%, 22rem);
    box-sizing: border-box;
    overflow: visible;
  }

  .folio-illustration--right {
    float: right;
    clear: right;
    margin: 0.15rem 0 1rem 1.5rem;
    max-width: min(38%, 18rem);
  }

  .folio-illustration--left {
    float: left;
    clear: left;
    margin: 0.15rem 1.5rem 1rem 0;
    max-width: min(38%, 18rem);
  }

  .folio-illustration__img {
    display: block;
    width: 100%;
    height: auto;
    border: none;
    vertical-align: bottom;
  }

  /* Opt-in frame for square / rectangular crops */
  .folio-illustration--framed .folio-illustration__img {
    border: 0.12rem solid color-mix(in srgb, var(--fg) 35%, var(--bg));
  }

  /*
   * Caption hangs below the image (not over it). Absolute so the figure
   * box does not grow. Parchment slip — page colours, not a dark film.
   */
  .folio-illustration__caption {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 4;
    box-sizing: border-box;
    margin: 0.3rem 0 0;
    padding: 0.4rem 0.55rem 0.45rem;
    font-size: 0.72em;
    line-height: 1.35;
    color: var(--fg);
    background: var(--bg, #fffff8);
    border: 0.08rem solid color-mix(in srgb, var(--fg) 32%, var(--bg));
    box-shadow: 0.1rem 0.1rem 0 color-mix(in srgb, var(--fg) 10%, transparent);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  .folio-illustration:hover .folio-illustration__caption,
  .folio-illustration:focus-within .folio-illustration__caption {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .folio-illustration__credit {
    display: block;
  }

  .folio-illustration__meta {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.95em;
    text-transform: lowercase;
    color: color-mix(in srgb, var(--fg) 72%, var(--bg));
  }

  /* Poem / notes start clean below any lede float */
  .folio-row {
    clear: both;
  }

  @media (max-width: 700px) {
    .folio-illustration--right,
    .folio-illustration--left {
      float: none;
      margin: 1.25rem auto;
      max-width: min(100%, 28rem);
    }

    .folio-illustration__caption {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }
</style>
