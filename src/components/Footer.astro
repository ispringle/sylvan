---
import Music from '@components/Music.astro'
import FooterTopBar from '@components/FooterTopBar.astro'
import FooterBottomBar from '@components/FooterBottomBar.astro'
---
<style>
footer {
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: visible;
  padding-top: 20rem;
  width: 100%;
  box-sizing: border-box;
}
.topline {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
/* Measure-wide chrome; mild left shift on wide screens (not full article inset) */
hr {
  max-width: var(--folio-measure, 66.9rem);
  width: 100%;
  margin: 0 auto;
  box-sizing: border-box;
}
.list {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin: 1rem;
}
[astro-icon] {
  display: inline;
  line-height: 1;
  height: 1.5em;
  width: 1.5em;
  fill: var(--fg)
}
a {
  text-decoration: none;
}

@media (min-width: 960px) {
  footer {
    padding-left: calc(
      var(--folio-left-rail, 26rem) + var(--folio-footer-inset, 4rem)
    );
    padding-right: 1rem;
  }
  hr {
    margin-left: 0;
    margin-right: auto;
  }
}
</style>
<footer id="rootFooter" data-turbo-permanent>
  <Music />
  <hr>
  <FooterTopBar/>
  <FooterBottomBar/>
</footer>
