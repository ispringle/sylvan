---
import Page from "@layouts/Page.astro";
import Image from '@components/Image.astro';
import Link from '@components/Link.astro';
import Excerpt from '@components/folio/Excerpt.astro';
import Note from '@components/folio/Note.astro';
import FolioRow from '@components/folio/FolioRow.astro';
import { allPages } from "@lib/pages";

export async function getStaticPaths() {
  const pages = await allPages;
  return pages.map((page) => {
    const path = page.frontmatter.slug
    return {
      params: {
        slug: path === "" ? undefined : path,
      },
      props: { page },
    };
  });
}
const {page} = Astro.props;
const { default: Content } = page;
---
<Page page={page}>
  <Content components={{
    a: Link,
    img: Image,
    Excerpt,
    Note,
    FolioRow,
  }}/>
</Page>
